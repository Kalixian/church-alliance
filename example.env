# Backend settings (app/config/settings.py). Copy to `.env` in the repo root
# and fill in. Unknown keys are rejected at startup, so keep compose/site
# variables (e.g. SITE_DOMAIN) in deploy/site.env instead.

# SQLAlchemy URL. Leave unset to use SQLite at ./church-alliance.db.
DATABASE_URL=

# Supabase project URL (Dashboard > Project Settings > Data API). The backend
# only verifies login tokens; it fetches the project's public signing keys from
# here, so it needs neither the publishable nor the secret API key.
SUPABASE_URL=https://your-project.supabase.co
# Only for projects still using the legacy HS256 JWT secret
# (Dashboard > Project Settings > JWT Keys). Leave blank otherwise.
SUPABASE_JWT_SECRET=

# Cloudinary account for gallery pictures (Dashboard > API Keys).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=church-alliance/pictures
# Unconfirmed uploads older than this are purged by `uv run python -m app.storage.cleanup`.
CLOUDINARY_PENDING_UPLOAD_TTL_HOURS=24

# Contact Us form (POST /api/v1/contact): the SMTP account that emails each
# administrator. Same values as deploy/contact.ini. Without a user and
# password the endpoint returns 503.
CONTACT_SMTP_HOST=smtp.gmail.com
# 587 uses STARTTLS; 465 uses implicit TLS.
CONTACT_SMTP_PORT=587
CONTACT_SMTP_USER=you@gmail.com
# A Google app password (requires 2-Step Verification), not the account password.
CONTACT_SMTP_PASSWORD=
# Address shown in From; Gmail only allows the account itself or a verified alias.
# Defaults to CONTACT_SMTP_USER.
CONTACT_SENDER=
CONTACT_SENDER_NAME=Church Alliance Website
