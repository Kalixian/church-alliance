# Frontend settings, read by Vite at build/dev time. Copy to `frontend/.env`.
# Everything here ends up in the browser bundle: never put secrets in it.

# Base URL of the FastAPI backend, without a trailing slash.
VITE_API_URL=http://localhost:8000

# Supabase project (Dashboard > Project Settings > API).
VITE_SUPABASE_URL=https://your-project.supabase.co
# The publishable key (sb_publishable_..., Dashboard > Project Settings > API Keys).
# Never the secret key (sb_secret_...).
VITE_SUPABASE_PUBLISHABLE_KEY=
