# Serves the built React app inside the frontend container (plain HTTP; the
# front caddy service terminates HTTPS). Unknown paths fall back to index.html
# because the app uses client-side routes (/about, /news/12, ...).
{
	admin off
	auto_https off
}

:80 {
	root * /srv
	encode zstd gzip
	try_files {path} /index.html

	# Hashed build assets never change; everything else (index.html under any
	# route, favicon, ...) must be revalidated so new deploys show up.
	# Matched on the request path, before try_files rewrites it.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@other not path /assets/*
	header @other Cache-Control "no-cache"

	file_server
}
