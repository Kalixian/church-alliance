# Caddy is the only service that publishes ports (80/443). It obtains and renews
# Let's Encrypt certificates automatically and forwards requests to the other
# services over the compose network by service name.
#
# SITE_DOMAIN comes from deploy/site.env. Without it Caddy serves
# https://localhost (and www.localhost) with a locally trusted certificate,
# for testing.

# The site: React app and API on one origin. /api/* goes to FastAPI, everything
# else to the frontend container, so the browser needs no CORS.
{$SITE_DOMAIN:localhost} {
	encode zstd gzip

	# Old static-site pages (bookmarks, search results) to their React routes.
	redir /index.html / permanent
	redir /about.html /about permanent
	redir /courses.html /courses permanent
	redir /contact.html /contact permanent

	# Photo uploads go straight to Cloudinary, so API bodies stay small.
	request_body /api/* {
		max_size 10MB
	}

	handle /api/* {
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy frontend:80
	}
}

# www redirects to the bare domain, keeping the path. Needs a DNS record for
# www.<domain>; without one Caddy keeps retrying its certificate.
www.{$SITE_DOMAIN:localhost} {
	redir https://{$SITE_DOMAIN:localhost}{uri} permanent
}
